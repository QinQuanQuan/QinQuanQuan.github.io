---
import { getCollection } from "astro:content";
import WikiNavNode, { type TreeNode } from "./WikiNavNode.astro";
import { folderLabel } from "@/lib/wiki/labels";
import { sortTreeNodes } from "@/lib/wiki/tree-utils";
import categoryOrder from "@/data/category-order.json";

const allNotes = await getCollection("wiki");
const currentPath = Astro.url.pathname.replace(/\/$/, "");
/** 首页分组顺序，同样用于左侧导航的分类顺序（后台「类别」页可调） */
const ORDER: string[] = categoryOrder as string[];

function humanize(slug: string): string {
  const label = folderLabel(slug);
  if (label !== slug) return label;

  return slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

function makeTreeNode(
  segment: string,
  isFile: boolean,
  note: (typeof allNotes)[number],
): TreeNode {
  return {
    label: isFile ? note.data.title : humanize(segment),
    href: isFile
      ? note.id === "index"
        ? "/wiki"
        : `/wiki/${note.id}`
      : undefined,
    children: {},
  };
}

function updateFileNode(node: TreeNode, note: (typeof allNotes)[number]): void {
  node.href = note.id === "index" ? "/wiki" : `/wiki/${note.id}`;
  node.label = note.data.title;
}

function buildTree(notes: typeof allNotes): Record<string, TreeNode> {
  const root: Record<string, TreeNode> = {};

  for (const note of notes) {
    const segments = note.id.split("/");
    let currentLevel = root;
    for (let i = 0; i < segments.length; i++) {
      const segment = segments[i];
      const isFile = i === segments.length - 1;

      if (!currentLevel[segment]) {
        currentLevel[segment] = makeTreeNode(segment, isFile, note);
      } else if (isFile) {
        updateFileNode(currentLevel[segment], note);
      }
      currentLevel = currentLevel[segment].children;
    }
  }

  return root;
}

const root = buildTree(allNotes);

/** 根级排序：先按 category-order.json 的顺序，未列出的保持原有规则 */
function sortRootKeys(children: Record<string, TreeNode>): string[] {
  const keys = sortTreeNodes(children);
  const orderKey = (key: string) => (key === "index" ? "overview" : key);

  return keys.sort((a, b) => {
    const ai = ORDER.indexOf(orderKey(a));
    const bi = ORDER.indexOf(orderKey(b));
    if (ai !== -1 && bi !== -1) return ai - bi;
    if (ai !== -1) return -1;
    if (bi !== -1) return 1;
    return 0;
  });
}

const sortedRootKeys = sortRootKeys(root);
---

<nav class="space-y-0.5">
  {
    sortedRootKeys.map((key) => (
      <WikiNavNode
        node={root[key]}
        depth={0}
        currentPath={currentPath}
        class="pb-4"
      />
    ))
  }
</nav>
